<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <Authors>techistad contributors</Authors>
    <Company>Termalogy OSS</Company>
    <Product>Termalogy Skin</Product>
    <Description>Terminal-first skin layer for Windows with command-based app access.</Description>
    <PackageProjectUrl>https://github.com/techistad/termalogy</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
