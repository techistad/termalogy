<Window x:Class="TermalogySkin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Termalogy Skin"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="#050805"
        Foreground="#96FF96"
        FontFamily="Cascadia Mono,Consolas"
        Topmost="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#206020"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Background="#030503">
            <ScrollViewer x:Name="OutputScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="OutputBlock"
                           FontSize="16"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="1"
                   Margin="2,10,2,10"
                   LastChildFill="False">
            <TextBlock x:Name="CurrentDirectoryText"
                       DockPanel.Dock="Left"
                       FontSize="12"
                       Foreground="#7AC97A"
                       Text="~" />
            <TextBlock x:Name="HintText"
                       DockPanel.Dock="Right"
                       FontSize="12"
                       Foreground="#4E8A4E"
                       Text="panic: Ctrl+Alt+Backspace" />
        </DockPanel>

        <Border Grid.Row="2"
                BorderBrush="#2F8A2F"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,6"
                Background="#040904">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           FontWeight="SemiBold"
                           Text=">" />
                <TextBox x:Name="CommandInput"
                         Grid.Column="1"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="#C2FFC2"
                         FontSize="16"
                         CaretBrush="#C2FFC2"
                         KeyDown="CommandInput_KeyDown" />
            </Grid>
        </Border>
    </Grid>
</Window>
